# Copy to .env.local for development, and set the same keys in the hosting
# platform's environment for production. .env.local is gitignored — never commit
# a real API key.

# --- Enquiry delivery (app/api/enquiry/route.ts, lib/mail.ts) ---------------

# Resend API key. Create one at https://resend.com/api-keys with "Sending
# access" only. WITHOUT THIS, enquiries are not delivered: in development the
# route logs the email it would have sent and returns ok; in production it
# returns 503 and tells the visitor to phone instead.
RESEND_API_KEY=

# Where enquiries land. Defaults to sknweb9@gmail.com when unset.
ENQUIRY_TO=sknweb9@gmail.com

# The sender. onboarding@resend.dev is Resend's shared test address and needs no
# DNS, but it ONLY delivers to the email that owns the Resend account — so sign
# up with ENQUIRY_TO above to test end to end.
#
# Before launch: verify shantikalanikketan.com in Resend (add its SPF/DKIM
# records), then switch this to an address on that domain.
ENQUIRY_FROM=Shanti Kala Nikketan <onboarding@resend.dev>


# --- Gallery prototype (lib/events.ts) --------------------------------------

# The /events gallery currently pads its photo set with invented captions so the
# 3D globe has enough plates to look right. Those records are flagged
# `placeholder: true`, are excluded from the Schema.org graph, and lib/events.ts
# THROWS at module load in production unless this is explicitly set.
#
# Leave this UNSET in the production environment. Setting it there would publish
# invented album names beside real photographs of real students.
#
# Remove this variable entirely once the academy's real albums are in
# REAL_PHOTOS and the PROTOTYPE_FILL spread has been deleted.
ALLOW_PLACEHOLDER_GALLERY=true
